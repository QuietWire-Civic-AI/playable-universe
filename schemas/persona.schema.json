{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quietwire.ai/schemas/playable-persona.v0.schema.json",
  "title": "Playable Universe Persona v0",
  "description": "Presentation/control identity inside a playable context. A persona is not itself a claim of legal identity or personhood.",
  "type": "object",
  "required": ["schema", "persona_id", "entity_id", "display_name", "control_mode"],
  "properties": {
    "schema": { "const": "playable.persona.v0" },
    "persona_id": { "type": "string", "minLength": 1 },
    "entity_id": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "control_mode": {
      "enum": ["human", "companion_agent", "historical_simulation", "npc", "mixed"]
    },
    "avatar": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["gltf", "usd", "sprite", "glyph", "engine_prefab", "audio_only", "none", "other"] },
        "uri": { "type": ["string", "null"] },
        "asset_ref": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "voice": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["live", "tts", "recorded", "none", "other"] },
        "profile_ref": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "temporal_envelope": {
      "type": "object",
      "properties": {
        "not_before": { "type": ["string", "null"], "format": "date-time" },
        "not_after": { "type": ["string", "null"], "format": "date-time" },
        "knowledge_cutoff": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "disclosure": {
      "type": "object",
      "properties": {
        "recording": { "enum": ["allowed", "denied", "ask", "policy_defined"] },
        "replay": { "enum": ["allowed", "denied", "ask", "policy_defined"] },
        "public_display": { "enum": ["allowed", "denied", "ask", "policy_defined"] }
      },
      "additionalProperties": false
    },
    "rights_refs": { "type": "array", "items": { "type": "string" } },
    "provenance_refs": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
